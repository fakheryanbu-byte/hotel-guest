# GEMINI_API_KEY: Required for server-side Gemini AI API calls.
# Never expose this key in client-side code or VITE_ variables.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Configurable Reception WhatsApp Numbers (international format digits only, e.g. 9665XXXXXXXX).
# Leave empty if not configured yet; the app will disable sending for unconfigured branches.
HOTEL_WHATSAPP_FAKHR_YANBU_1=""
HOTEL_WHATSAPP_FAKHR_YANBU_3=""
HOTEL_WHATSAPP_FAKHR_YANBU_5=""
HOTEL_WHATSAPP_TIM_HOTEL=""
